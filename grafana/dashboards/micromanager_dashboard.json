        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "displayMode": "gradient",
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        },
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "micromanager-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT bundle_id AS \"application\", SUM(minutes_on)::float AS \"minutes\"\nFROM micromanager.application_usage\nGROUP BY bundle_id\nORDER BY \"minutes\" DESC",
          "refId": "A"
        }
      ],
      "title": "Top applications (minutes)",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "micromanager-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "decimals": 1,
          "unit": "min"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [
            "sum"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "micromanager-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT date::timestamp AS \"time\", bundle_id AS metric, SUM(minutes_on)::float AS \"minutes\"\nFROM micromanager.application_usage\nGROUP BY date, bundle_id\nORDER BY date",
          "refId": "A"
        }
      ],
      "title": "Application usage per day",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "micromanager-postgres"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "showPoints": "auto"
          },
          "decimals": 1,
          "unit": "min"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
